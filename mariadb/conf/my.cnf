[mysqld]
port                = 3306

# Errors go to the container output: `docker compose logs mariadb`.
# (A log file under a bind-mounted folder fails with "Permission denied",
# because mariadbd runs as the mysql user, not as the folder's owner.)

# No general query log: it records every statement from every server,
# grows without limit and would store account password hashes.
general_log         = 0

# Slow queries (over 2 s) are kept, in the data directory, which mariadbd can
# write: data/mysql/slow.log on the host.
slow_query_log      = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time     = 2
