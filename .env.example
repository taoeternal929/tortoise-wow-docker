# Copy this file to .env and fill it in:   cp .env.example .env
# .env is not tracked by git, so your passwords and addresses stay local.
# docker compose refuses to start while a required value is missing.

# ── Network ───────────────────────────────────────────────────────────────
# Your host machine's LAN IP: the address other machines use to reach it.
# realmd hands it to WoW clients. On Linux:
#   ip route get 1.1.1.1 | awk '{for(i=1;i<=NF;i++) if ($i=="src") print $(i+1)}'
HOST_IP=192.168.1.x

# Full URL (with port) players use for the registration portal.
SITE_URL=http://192.168.1.x:8080

# ── Database ──────────────────────────────────────────────────────────────
# Used when the database is first created (empty data/mysql). For an existing
# database, see "Changing database passwords" in README.md.
# Avoid ; in these passwords: the server configs use it as a separator.
MYSQL_ROOT_PASSWORD=change-me-root

# Login used by realmd and mangosd (full access to the four tw_* databases).
MYSQL_USER=mangos
MYSQL_PASSWORD=change-me

# Login used by the registration portal (account tables only).
REGISTRATION_DB_USER=wowreg
REGISTRATION_DB_PASSWORD=change-me-too

# Name of the realm row whose address is set to HOST_IP (tw_logon.realmlist).
REALM_NAME=TurtleWoW
