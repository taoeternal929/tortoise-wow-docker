# ── WoW Simple Registration ───────────────────────────────────────────────────
# Full URL (including port) that users will access the registration page from.
# Use your host machine's LAN IP or domain name.
SITE_URL=http://192.168.1.225:8080
HOST_IP=192.168.1.225

# ── Database ──────────────────────────────────────────────────────────────────
# These values are used by the wow-db MySQL container.
# They must also match what you set in application/config/config.php.
MYSQL_ROOT_PASSWORD=yourRootPassword
MYSQL_USER=mangos
MYSQL_PASSWORD=mangos
